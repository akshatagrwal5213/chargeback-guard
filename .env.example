# Copy to .env and fill in. The API boots with all of these empty —
# /health will report which components are unconfigured.

# ---- Postgres (Supabase: Project settings -> Database -> Connection string)
# LEAVE THIS BLANK until you have a real connection string. A placeholder host
# is not the same as no host — the app would try to resolve it and report the
# database as down.
#
# When you have one, it looks like:
#   postgresql://postgres:<your-password>@db.<your-project>.supabase.co:5432/postgres
#
# Use the direct connection / "Session pooler" URI, not the transaction pooler:
# asyncpg needs prepared statements.
DATABASE_URL=

# ---- Stripe (TEST MODE ONLY — a live key makes the app refuse to start)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Razorpay (optional until the Indian rail goes live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Evidence agent. Configure ONE of these, or neither.
#
# With none set, packets still compose deterministically from templates —
# the citation guarantee is structural, not model-dependent, so a reviewer
# can clone this and see the whole pipeline run with no credentials.
#
# Gemini: free tier, get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Leave blank to use each provider's default.
AGENT_MODEL=

# ---- Triage economics, in rupees
DISPUTE_FEE=1200
CONTEST_EFFORT_COST=250
ESCALATION_RISK_COST=900
